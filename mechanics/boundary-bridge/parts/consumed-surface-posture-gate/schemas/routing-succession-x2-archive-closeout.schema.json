            "passed_subtests": {
              "type": "integer",
              "minimum": 1
            },
            "result": {
              "const": "passed"
            }
          }
        },
        "final_review_result": {
          "const": "no_major_issues"
        }
      }
    },
    "deprecation_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "tag",
        "name",
        "url",
        "target_commit",
        "published_at",
        "draft",
        "prerelease",
        "adds_routing_behavior",
        "routes_future_work_to"
