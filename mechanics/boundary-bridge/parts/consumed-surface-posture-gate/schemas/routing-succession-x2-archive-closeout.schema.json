      "properties": {
        "repository": {
          "$ref": "#/$defs/repositoryIdentity"
        },
        "archived": {
          "const": true
        },
        "disabled": {
          "const": false
        },
        "visibility": {
          "const": "public"
        },
        "default_branch": {
          "const": "main"
