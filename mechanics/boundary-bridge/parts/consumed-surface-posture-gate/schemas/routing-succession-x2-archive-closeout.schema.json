            "query_status",
            "historical_runtime_slice_present"
          ],
          "properties": {
            "trace_id": {
              "type": "string",
              "format": "uuid"
            },
            "projection_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "projection_updated_at": {
              "$ref": "#/$defs/dateTime"
            },
            "predecessor_runtime_source_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "predecessor_canonical_source_digest": {
              "const": ""
            },
            "freshness_state": {
              "const": "source_unavailable"
            },
            "query_status": {
              "const": "degraded"
            },
            "historical_runtime_slice_present": {
              "const": true
            }
          }
        },
        "residual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "active_consumer_dependency",
            "source_owner_route_correct",
            "blocks_succession_closeout",
            "reason"
          ],
          "properties": {
            "classification": {
              "const": "derived_projection_refresh_pending"
            },
            "active_consumer_dependency": {
              "const": false
            },
            "source_owner_route_correct": {
              "const": true
            },
            "blocks_succession_closeout": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sdk_release_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "expected_version",
        "latest_tag",
        "release_url",
        "passed"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "const": "0.9.0"
        },
        "latest_tag": {
          "const": "v0.9.0"
        },
        "release_url": {
          "$ref": "#/$defs/uri"
        },
        "passed": {
          "const": true
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdk_single_canonical_routing_owner",
        "runtime_uses_sdk_artifact",
        "active_predecessor_checkout_consumers",
        "compatibility_window_exited",
        "predecessor_archived",
        "predecessor_preserved",
        "deprecation_release_published",
        "operator_scope_respected",
        "delete_or_rename_executed",
        "succession_complete",
        "claim_limit"
      ],
      "properties": {
        "sdk_single_canonical_routing_owner": {
          "const": true
        },
        "runtime_uses_sdk_artifact": {
          "const": true
        },
        "active_predecessor_checkout_consumers": {
          "const": 0
        },
        "compatibility_window_exited": {
          "const": true
        },
        "predecessor_archived": {
          "const": true
        },
        "predecessor_preserved": {
          "const": true
        },
        "deprecation_release_published": {
          "const": true
        },
        "operator_scope_respected": {
          "const": true
        },
        "delete_or_rename_executed": {
          "const": false
        },
        "succession_complete": {
          "const": true
        },
        "claim_limit": {
          "type": "string",
          "minLength": 1
        }
      }
    }
