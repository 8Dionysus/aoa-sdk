    "report_id": {
      "const": "routing-succession-x2-archive-closeout"
    },
    "observed_at_utc": {
      "$ref": "#/$defs/dateTime"
    },
    "x1_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref",
        "evidence_sha256",
        "landed_main_ref",
        "landed_main_validation_run_id",
        "landed_main_validation_url",
        "archive_readiness_ref",
        "archive_readiness_validation_run_id",
        "archive_readiness_validation_url",
        "immutable_historical_receipt",
        "historical_archive_authorized",
        "historical_archive_executed"
      ],
      "properties": {
        "evidence_ref": {
          "const": "mechanics/boundary-bridge/parts/consumed-surface-posture-gate/evidence/routing-succession-x1-consumer-zero-report.json"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "landed_main_ref": {
          "$ref": "#/$defs/gitSha"
        },
        "landed_main_validation_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "landed_main_validation_url": {
          "$ref": "#/$defs/uri"
        },
        "archive_readiness_ref": {
          "$ref": "#/$defs/gitSha"
        },
        "archive_readiness_validation_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "archive_readiness_validation_url": {
          "$ref": "#/$defs/uri"
        },
        "immutable_historical_receipt": {
          "const": true
        },
        "historical_archive_authorized": {
          "const": false
        },
        "historical_archive_executed": {
          "const": false
        }
      }
    },
    "operator_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granted",
        "authority_source",
        "repository",
        "approved_actions",
        "forbidden_actions",
        "approval_scope_exact"
