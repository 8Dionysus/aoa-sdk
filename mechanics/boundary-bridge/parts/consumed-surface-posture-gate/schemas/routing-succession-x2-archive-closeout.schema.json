        "renamed": {
          "const": false
        },
        "deleted": {
          "const": false
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "$ref": "#/$defs/uri"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "const": "aoa-sdk"
          },
          "minContains": 1,
          "uniqueItems": true,
          "minItems": 1
        },
        "public_http_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpCheck"
          },
          "minItems": 3,
          "maxItems": 3
