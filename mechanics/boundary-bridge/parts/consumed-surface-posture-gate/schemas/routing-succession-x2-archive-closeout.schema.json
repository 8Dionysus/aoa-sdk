        "tag": {
          "const": "v0.4.0"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/uri"
        },
        "target_commit": {
          "$ref": "#/$defs/gitSha"
        },
        "published_at": {
          "$ref": "#/$defs/dateTime"
        },
        "draft": {
          "const": false
        },
        "prerelease": {
          "const": false
        },
        "adds_routing_behavior": {
          "const": false
        },
        "routes_future_work_to": {
          "const": "8Dionysus/aoa-sdk"
        }
      }
    },
    "github_archive_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "archived",
        "disabled",
        "visibility",
        "default_branch",
        "renamed",
        "deleted",
        "description",
        "homepage",
        "topics",
        "public_http_checks",
        "observed_at_utc"
