            "landed_main_ref": {
              "$ref": "#/$defs/gitSha"
            },
            "main_validation_run_id": {
              "type": "integer",
              "minimum": 1
            },
            "main_validation_url": {
              "$ref": "#/$defs/uri"
            },
            "aoa_routing_active_provider": {
              "const": false
            },
            "current_routing_owner_route": {
              "const": "aoa-sdk"
            }
          }
        },
        "live_projection_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trace_id",
            "projection_digest",
            "projection_updated_at",
