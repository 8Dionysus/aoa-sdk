            "exact_head_validation_url": {
              "$ref": "#/$defs/uri"
            },
            "merged_at": {
              "$ref": "#/$defs/dateTime"
            }
          }
        },
        "landed_main_ref": {
          "$ref": "#/$defs/gitSha"
        },
        "main_validation_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "main_validation_url": {
          "$ref": "#/$defs/uri"
        },
        "main_validation_conclusion": {
          "const": "success"
        },
        "full_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed_tests",
            "skipped_tests",
            "passed_subtests",
            "result"
