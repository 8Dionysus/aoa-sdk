            {
              "const": "archive_repository"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "forbidden_actions": {
          "type": "array",
          "prefixItems": [
            {
              "const": "delete_repository"
            },
            {
              "const": "rename_repository"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "approval_scope_exact": {
          "const": true
        }
      }
    },
    "predecessor_landing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
