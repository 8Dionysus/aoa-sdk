  "$defs": {
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node_id",
        "full_name"
      ],
      "properties": {
        "id": {
          "const": 1186624390
        },
        "node_id": {
          "const": "R_kgDORrpzhg"
        },
        "full_name": {
          "const": "8Dionysus/aoa-routing"
        }
      }
    },
    "httpCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "url",
        "status"
      ],
      "properties": {
        "surface": {
          "enum": [
            "repository",
            "readme",
            "release"
          ]
        },
        "url": {
          "$ref": "#/$defs/uri"
        },
        "status": {
          "const": 200
        }
