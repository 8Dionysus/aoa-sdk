            "required_file_count": {
              "type": "integer",
              "minimum": 1
            },
            "trust_verdict": {
              "const": "allow"
            },
            "trust_record_id": {
              "$ref": "#/$defs/sha256"
            },
            "subject_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
