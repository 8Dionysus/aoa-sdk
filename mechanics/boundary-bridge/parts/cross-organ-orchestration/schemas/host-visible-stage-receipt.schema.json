{
  "$defs": {
    "SchemaIdentity": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Digest",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Schema Ref",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "schema_ref",
        "schema_digest",
        "source_revision",
        "schema_version"
      ],
      "title": "SchemaIdentity",
      "type": "object"
    },
    "TypedArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "artifact_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Artifact Ref",
          "type": "string"
        },
        "authority_ceiling": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Authority Ceiling",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "ref_kind": {
          "enum": [
            "orchestration_intent",
            "kag_evidence",
            "memo_candidate",
            "eval_request",
            "eval_result",
            "owner_acceptance"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "schema_identity": {
          "$ref": "#/$defs/SchemaIdentity"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "ref_kind",
        "owner",
        "artifact_ref",
        "artifact_digest",
        "source_revision",
        "schema_identity",
        "authority_ceiling",
        "created_at"
      ],
      "title": "TypedArtifactRef",
      "type": "object"
    }
  },
  "$id": "urn:aoa-sdk:cross-organ-orchestration:host-visible-stage-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "host_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Host Id",
      "type": "string"
    },
    "input_artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Artifact Digest",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "observed",
        "candidate_created",
        "request_created",
        "validated",
        "accepted",
        "rejected",
        "stopped",
        "denied"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "output_artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Artifact Digest",
      "type": "string"
    },
    "owner_receipt_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TypedArtifactRef"
      },
      "title": "Owner Receipt Refs",
      "type": "array"
    },
    "previous_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Previous Snapshot Digest",
      "type": "string"
    },
    "receipt_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Receipt Digest",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_ref": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Receipt Ref",
      "type": "string"
    },
    "run_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "aoa_host_stage_receipt_v1",
      "default": "aoa_host_stage_receipt_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_kind": {
      "enum": [
        "kag_evidence",
        "memo_candidate",
        "eval_request",
        "eval_result",
        "owner_acceptance"
      ],
      "title": "Stage Kind",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "receipt_ref",
    "receipt_digest",
    "host_id",
    "run_id",
    "stage_kind",
    "previous_snapshot_digest",
    "input_artifact_digest",
    "output_artifact_digest",
    "issued_at",
    "outcome"
  ],
  "title": "HostVisibleStageReceipt",
  "type": "object"
}
