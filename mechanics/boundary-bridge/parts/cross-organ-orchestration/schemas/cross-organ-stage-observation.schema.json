{
  "$defs": {
    "HostVisibleStageReceipt": {
      "additionalProperties": false,
      "properties": {
        "host_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "input_artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Artifact Digest",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "observed",
            "candidate_created",
            "request_created",
            "validated",
            "accepted",
            "rejected",
            "stopped",
            "denied"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Artifact Digest",
          "type": "string"
        },
        "owner_receipt_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TypedArtifactRef"
          },
          "title": "Owner Receipt Refs",
          "type": "array"
        },
        "previous_snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Previous Snapshot Digest",
          "type": "string"
        },
        "receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Digest",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "receipt_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Receipt Ref",
          "type": "string"
        },
        "run_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "aoa_host_stage_receipt_v1",
          "default": "aoa_host_stage_receipt_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage_kind": {
          "enum": [
            "kag_evidence",
            "memo_candidate",
            "eval_request",
            "eval_result",
            "owner_acceptance"
          ],
          "title": "Stage Kind",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "receipt_ref",
        "receipt_digest",
        "host_id",
        "run_id",
        "stage_kind",
        "previous_snapshot_digest",
        "input_artifact_digest",
        "output_artifact_digest",
        "issued_at",
        "outcome"
      ],
      "title": "HostVisibleStageReceipt",
      "type": "object"
    },
    "QualifiedEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Evidence Ref",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "evidence_ref",
        "revision",
        "observed_at"
      ],
      "title": "QualifiedEvidenceRef",
      "type": "object"
    },
    "SchemaIdentity": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Digest",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Schema Ref",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "schema_ref",
        "schema_digest",
        "source_revision",
        "schema_version"
      ],
      "title": "SchemaIdentity",
      "type": "object"
    },
    "TypedArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "artifact_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Artifact Ref",
          "type": "string"
        },
        "authority_ceiling": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Authority Ceiling",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "ref_kind": {
          "enum": [
            "orchestration_intent",
            "kag_evidence",
            "memo_candidate",
            "eval_request",
            "eval_result",
            "owner_acceptance"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "schema_identity": {
          "$ref": "#/$defs/SchemaIdentity"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "ref_kind",
        "owner",
        "artifact_ref",
        "artifact_digest",
        "source_revision",
        "schema_identity",
        "authority_ceiling",
        "created_at"
      ],
      "title": "TypedArtifactRef",
      "type": "object"
    }
  },
  "$id": "urn:aoa-sdk:cross-organ-orchestration:cross-organ-stage-observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_decision": {
      "anyOf": [
        {
          "enum": [
            "accepted",
            "rejected"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acceptance Decision"
    },
    "applied_state": {
      "enum": [
        "not_applied",
        "candidate_only",
        "applied",
        "denied"
      ],
      "title": "Applied State",
      "type": "string"
    },
    "authority_ceiling": {
      "enum": [
        "read",
        "candidate",
        "internal_effect",
        "external_effect"
      ],
      "title": "Authority Ceiling",
      "type": "string"
    },
    "effect_class": {
      "enum": [
        "observe",
        "derive",
        "validate",
        "prepare_candidate",
        "apply_runtime",
        "accept_source",
        "external_emit",
        "external_change"
      ],
      "title": "Effect Class",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/QualifiedEvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "freshness_state": {
      "enum": [
        "exact",
        "compatible_drift",
        "stale_readable",
        "blocked",
        "unknown",
        "rollback_required"
      ],
      "title": "Freshness State",
      "type": "string"
    },
    "input_ref": {
      "$ref": "#/$defs/TypedArtifactRef"
    },
    "input_schema_identity": {
      "$ref": "#/$defs/SchemaIdentity"
    },
    "mcp_tools_executed_by_sdk": {
      "const": false,
      "default": false,
      "title": "Mcp Tools Executed By Sdk",
      "type": "boolean"
    },
    "model_confidence_is_acceptance_authority": {
      "const": false,
      "default": false,
      "title": "Model Confidence Is Acceptance Authority",
      "type": "boolean"
    },
    "next_owner": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Owner"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "output_ref": {
      "$ref": "#/$defs/TypedArtifactRef"
    },
    "output_schema_identity": {
      "$ref": "#/$defs/SchemaIdentity"
    },
    "receipt": {
      "$ref": "#/$defs/HostVisibleStageReceipt"
    },
    "review_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualifiedEvidenceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "stage_kind": {
      "enum": [
        "kag_evidence",
        "memo_candidate",
        "eval_request",
        "eval_result",
        "owner_acceptance"
      ],
      "title": "Stage Kind",
      "type": "string"
    },
    "stage_owner": {
      "minLength": 1,
      "title": "Stage Owner",
      "type": "string"
    },
    "stop_reason_codes": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
        "type": "string"
      },
      "title": "Stop Reason Codes",
      "type": "array"
    },
    "transition_state": {
      "enum": [
        "proceed",
        "stopped",
        "denied",
        "accepted_terminal",
        "rejected_terminal"
      ],
      "title": "Transition State",
      "type": "string"
    }
  },
  "required": [
    "stage_kind",
    "stage_owner",
    "source_revision",
    "input_ref",
    "output_ref",
    "input_schema_identity",
    "output_schema_identity",
    "evidence_refs",
    "freshness_state",
    "observed_at",
    "expires_at",
    "authority_ceiling",
    "effect_class",
    "applied_state",
    "receipt",
    "next_owner",
    "transition_state"
  ],
  "title": "CrossOrganStageObservation",
  "type": "object"
}
