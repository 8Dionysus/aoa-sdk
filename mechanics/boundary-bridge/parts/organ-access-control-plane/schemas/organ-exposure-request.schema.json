{
  "$defs": {
    "QualifiedEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Evidence Ref",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "evidence_ref",
        "revision",
        "observed_at"
      ],
      "title": "QualifiedEvidenceRef",
      "type": "object"
    }
  },
  "$id": "urn:aoa-sdk:organ-access:organ-exposure-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit request for schema reveal; it is not an activation approval.",
  "properties": {
    "approval_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualifiedEvidenceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "baseline_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualifiedEvidenceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "baseline_ready": {
      "default": false,
      "title": "Baseline Ready",
      "type": "boolean"
    },
    "capability_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Capability Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "organ_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Organ Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_policy_family": {
      "default": "read",
      "enum": [
        "read",
        "candidate",
        "internal_effect",
        "external_effect"
      ],
      "title": "Requested Policy Family",
      "type": "string"
    },
    "reveal_schemas": {
      "default": false,
      "title": "Reveal Schemas",
      "type": "boolean"
    },
    "schema_version": {
      "const": "aoa_organ_exposure_v1",
      "default": "aoa_organ_exposure_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_primitive_ids": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Selected Primitive Ids",
      "type": "array"
    },
    "selection_reason": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selection Reason"
    }
  },
  "required": [
    "request_id",
    "organ_id",
    "capability_id",
    "requested_at",
    "expires_at"
  ],
  "title": "ExposureSelectionRequest",
  "type": "object"
}
