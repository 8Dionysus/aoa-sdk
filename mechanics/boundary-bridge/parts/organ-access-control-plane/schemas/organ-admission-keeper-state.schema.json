{
  "$defs": {
    "AdmissionKeeperStageState": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "default": false,
          "title": "Current",
          "type": "boolean"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "node_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "passed",
                "blocked",
                "rejected",
                "revoked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "stage": {
          "enum": [
            "owner_source",
            "package",
            "deployment",
            "process",
            "endpoint",
            "credential",
            "schema",
            "authenticated_canary",
            "owner_grounding",
            "central_proof",
            "owner_acceptance",
            "rollback",
            "registry_admission",
            "consumer_observation"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage"
      ],
      "title": "AdmissionKeeperStageState",
      "type": "object"
    }
  },
  "$id": "urn:aoa-sdk:organ-access:organ-admission-keeper-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_current": {
      "title": "Admission Current",
      "type": "boolean"
    },
    "blocker_codes": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
        "type": "string"
      },
      "title": "Blocker Codes",
      "type": "array"
    },
    "contour_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Contour Id",
      "type": "string"
    },
    "currentness": {
      "items": {
        "enum": [
          "live",
          "observed",
          "verified",
          "admitted",
          "stale_readable",
          "candidate",
          "blocked",
          "last_good"
        ],
        "type": "string"
      },
      "title": "Currentness",
      "type": "array"
    },
    "immutable_evidence_only": {
      "const": true,
      "default": true,
      "title": "Immutable Evidence Only",
      "type": "boolean"
    },
    "last_good_state_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Good State Digest"
    },
    "last_good_state_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Good State Ref"
    },
    "next_safe_stage": {
      "anyOf": [
        {
          "enum": [
            "owner_source",
            "package",
            "deployment",
            "process",
            "endpoint",
            "credential",
            "schema",
            "authenticated_canary",
            "owner_grounding",
            "central_proof",
            "owner_acceptance",
            "rollback",
            "registry_admission",
            "consumer_observation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Safe Stage"
    },
    "organ_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Organ Id",
      "type": "string"
    },
    "owner_acceptance_issued_by_keeper": {
      "const": false,
      "default": false,
      "title": "Owner Acceptance Issued By Keeper",
      "type": "boolean"
    },
    "proof_verdict_issued_by_keeper": {
      "const": false,
      "default": false,
      "title": "Proof Verdict Issued By Keeper",
      "type": "boolean"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "aoa_admission_keeper_state_v1",
      "default": "aoa_admission_keeper_state_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Spec Id",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/AdmissionKeeperStageState"
      },
      "title": "Stages",
      "type": "array"
    },
    "state_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "State Id",
      "type": "string"
    },
    "timestamps_extended_in_place": {
      "const": false,
      "default": false,
      "title": "Timestamps Extended In Place",
      "type": "boolean"
    },
    "transaction_ref": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Transaction Ref",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "state_id",
    "revision",
    "spec_id",
    "organ_id",
    "contour_id",
    "transaction_ref",
    "updated_at",
    "stages",
    "currentness",
    "admission_current"
  ],
  "title": "AdmissionKeeperState",
  "type": "object"
}
