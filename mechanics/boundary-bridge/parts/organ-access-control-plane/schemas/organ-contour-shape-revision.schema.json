{
  "$defs": {
    "CapabilityContract": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "credential_class": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Credential Class",
          "type": "string"
        },
        "eval_refs": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 3,
            "type": "string"
          },
          "title": "Eval Refs",
          "type": "array"
        },
        "owner_payload_schema_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Owner Payload Schema Ref",
          "type": "string"
        },
        "policy_family": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Policy Family",
          "type": "string"
        },
        "primitives": {
          "items": {
            "$ref": "#/$defs/PrimitiveContract"
          },
          "title": "Primitives",
          "type": "array"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 12,
          "title": "Summary",
          "type": "string"
        },
        "task_intent_terms": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
            "type": "string"
          },
          "title": "Task Intent Terms",
          "type": "array"
        }
      },
      "required": [
        "capability_id",
        "summary",
        "policy_family",
        "credential_class",
        "primitives",
        "owner_payload_schema_ref"
      ],
      "title": "CapabilityContract",
      "type": "object"
    },
    "ContourSupplementEntry": {
      "additionalProperties": false,
      "description": "One owner-declared contour shape, without admission state.",
      "properties": {
        "authority_class": {
          "enum": [
            "read",
            "candidate",
            "proof_result",
            "internal_effect",
            "external_effect"
          ],
          "title": "Authority Class",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityContract"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "contour_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Contour Id",
          "type": "string"
        },
        "credential_class": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Credential Class",
          "type": "string"
        },
        "observation_route": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Observation Route",
          "type": "string"
        },
        "policy_family": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Policy Family",
          "type": "string"
        },
        "principal_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Principal Id",
          "type": "string"
        },
        "rollback_route": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Rollback Route",
          "type": "string"
        }
      },
      "required": [
        "contour_id",
        "authority_class",
        "policy_family",
        "credential_class",
        "principal_id",
        "capabilities",
        "observation_route",
        "rollback_route"
      ],
      "title": "ContourSupplementEntry",
      "type": "object"
    },
    "PrimitiveContract": {
      "additionalProperties": false,
      "properties": {
        "annotations_are_security_enforcement": {
          "const": false,
          "default": false,
          "title": "Annotations Are Security Enforcement",
          "type": "boolean"
        },
        "approval_owner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Owner"
        },
        "approval_required": {
          "default": false,
          "title": "Approval Required",
          "type": "boolean"
        },
        "effect_class": {
          "enum": [
            "observe",
            "derive",
            "validate",
            "prepare_candidate",
            "apply_runtime",
            "accept_source",
            "external_emit",
            "external_change"
          ],
          "title": "Effect Class",
          "type": "string"
        },
        "idempotency": {
          "enum": [
            "read_only",
            "idempotent",
            "idempotency_key_required",
            "non_idempotent"
          ],
          "title": "Idempotency",
          "type": "string"
        },
        "input_schema_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Schema Ref"
        },
        "kind": {
          "enum": [
            "tool",
            "resource",
            "resource_template",
            "prompt"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum_blast_radius": {
          "minLength": 1,
          "title": "Maximum Blast Radius",
          "type": "string"
        },
        "mcp_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcp Name"
        },
        "output_schema_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Output Schema Ref",
          "type": "string"
        },
        "policy_family": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Policy Family",
          "type": "string"
        },
        "primitive_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Primitive Id",
          "type": "string"
        },
        "rollback_route": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rollback Route"
        }
      },
      "required": [
        "primitive_id",
        "kind",
        "effect_class",
        "policy_family",
        "output_schema_ref",
        "idempotency",
        "maximum_blast_radius"
      ],
      "title": "PrimitiveContract",
      "type": "object"
    },
    "QualifiedEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Evidence Ref",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "evidence_ref",
        "revision",
        "observed_at"
      ],
      "title": "QualifiedEvidenceRef",
      "type": "object"
    },
    "RevisionIdentity": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "schema_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Digest"
        }
      },
      "required": [
        "revision"
      ],
      "title": "RevisionIdentity",
      "type": "object"
    }
  },
  "$id": "urn:aoa-sdk:organ-access:organ-contour-shape-revision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Owner-authored replacement shape that cannot preserve contour claims.",
  "properties": {
    "acceptance_asserted": {
      "const": false,
      "default": false,
      "title": "Acceptance Asserted",
      "type": "boolean"
    },
    "admission_asserted": {
      "const": false,
      "default": false,
      "title": "Admission Asserted",
      "type": "boolean"
    },
    "contains_secrets": {
      "const": false,
      "default": false,
      "title": "Contains Secrets",
      "type": "boolean"
    },
    "contour": {
      "$ref": "#/$defs/ContourSupplementEntry"
    },
    "currentness_refreshed": {
      "const": false,
      "default": false,
      "title": "Currentness Refreshed",
      "type": "boolean"
    },
    "expected_contour_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Expected Contour Digest",
      "type": "string"
    },
    "organ_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Organ Id",
      "type": "string"
    },
    "owner_decision_ref": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Owner Decision Ref",
      "type": "string"
    },
    "proof_asserted": {
      "const": false,
      "default": false,
      "title": "Proof Asserted",
      "type": "boolean"
    },
    "revision_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Revision Id",
      "type": "string"
    },
    "runtime_identity_asserted": {
      "const": false,
      "default": false,
      "title": "Runtime Identity Asserted",
      "type": "boolean"
    },
    "schema_version": {
      "const": "aoa_organ_contour_shape_revision_v1",
      "default": "aoa_organ_contour_shape_revision_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence": {
      "$ref": "#/$defs/QualifiedEvidenceRef"
    },
    "source_owner": {
      "minLength": 1,
      "title": "Source Owner",
      "type": "string"
    },
    "source_revision": {
      "$ref": "#/$defs/RevisionIdentity"
    }
  },
  "required": [
    "revision_id",
    "organ_id",
    "source_owner",
    "source_revision",
    "source_evidence",
    "owner_decision_ref",
    "expected_contour_digest",
    "contour"
  ],
  "title": "OrganContourShapeRevision",
  "type": "object"
}
