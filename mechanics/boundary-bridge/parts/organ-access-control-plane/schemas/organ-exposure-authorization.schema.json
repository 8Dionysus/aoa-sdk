{
  "$defs": {
    "QualifiedEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Evidence Ref",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "evidence_ref",
        "revision",
        "observed_at"
      ],
      "title": "QualifiedEvidenceRef",
      "type": "object"
    }
  },
  "$id": "urn:aoa-sdk:organ-access:organ-exposure-authorization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed handoff from disclosure to the external activation authority.",
  "properties": {
    "activation_authorized": {
      "const": false,
      "default": false,
      "title": "Activation Authorized",
      "type": "boolean"
    },
    "approval_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualifiedEvidenceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authorization_state": {
      "enum": [
        "blocked",
        "external_owner_required"
      ],
      "title": "Authorization State",
      "type": "string"
    },
    "execution_authorized": {
      "const": false,
      "default": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "rendered_snapshot_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rendered Snapshot Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "rollback_route": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Rollback Route",
      "type": "string"
    },
    "schema_version": {
      "const": "aoa_organ_exposure_plan_v1",
      "default": "aoa_organ_exposure_plan_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "visible_bytes": {
      "minimum": 0,
      "title": "Visible Bytes",
      "type": "integer"
    },
    "visible_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visible Tokens"
    },
    "visible_tool_ids": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Visible Tool Ids",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "request_id",
    "authorization_state",
    "rendered_snapshot_id",
    "visible_tool_ids",
    "visible_bytes",
    "reason_codes",
    "rollback_route"
  ],
  "title": "ExposureAuthorizationCandidate",
  "type": "object"
}
