{
  "$defs": {
    "FreshnessPolicy": {
      "additionalProperties": false,
      "properties": {
        "cache_scope": {
          "enum": [
            "none",
            "request",
            "task",
            "agent",
            "workspace"
          ],
          "title": "Cache Scope",
          "type": "string"
        },
        "max_age_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "policy_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Policy Id",
          "type": "string"
        },
        "provider_watermark_required": {
          "default": true,
          "title": "Provider Watermark Required",
          "type": "boolean"
        },
        "stale_readable_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Stale Readable Seconds",
          "type": "integer"
        }
      },
      "required": [
        "policy_id",
        "max_age_seconds",
        "cache_scope"
      ],
      "title": "FreshnessPolicy",
      "type": "object"
    },
    "OrganOwners": {
      "additionalProperties": false,
      "properties": {
        "acceptance_owner": {
          "minLength": 1,
          "title": "Acceptance Owner",
          "type": "string"
        },
        "access_owner": {
          "minLength": 1,
          "title": "Access Owner",
          "type": "string"
        },
        "control_owner": {
          "const": "aoa-sdk",
          "default": "aoa-sdk",
          "title": "Control Owner",
          "type": "string"
        },
        "proof_owner": {
          "minLength": 1,
          "title": "Proof Owner",
          "type": "string"
        },
        "runtime_owner": {
          "minLength": 1,
          "title": "Runtime Owner",
          "type": "string"
        },
        "source_owner": {
          "minLength": 1,
          "title": "Source Owner",
          "type": "string"
        }
      },
      "required": [
        "source_owner",
        "access_owner",
        "runtime_owner",
        "proof_owner",
        "acceptance_owner"
      ],
      "title": "OrganOwners",
      "type": "object"
    },
    "OrganResultMetadata": {
      "additionalProperties": false,
      "properties": {
        "applied_state": {
          "enum": [
            "not_applied",
            "applied",
            "denied",
            "candidate_only"
          ],
          "title": "Applied State",
          "type": "string"
        },
        "authority_ceiling": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Authority Ceiling",
          "type": "string"
        },
        "cache_scope": {
          "enum": [
            "none",
            "request",
            "task",
            "agent",
            "workspace"
          ],
          "title": "Cache Scope",
          "type": "string"
        },
        "capability_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "consumer_observed_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Consumer Observed Digest",
          "type": "string"
        },
        "contract_version": {
          "const": "aoa_organ_result_envelope_v1",
          "default": "aoa_organ_result_envelope_v1",
          "title": "Contract Version",
          "type": "string"
        },
        "deployed_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deployed Revision"
        },
        "effect_class": {
          "enum": [
            "observe",
            "derive",
            "validate",
            "prepare_candidate",
            "apply_runtime",
            "accept_source",
            "external_emit",
            "external_change"
          ],
          "title": "Effect Class",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/QualifiedEvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "freshness_policy": {
          "$ref": "#/$defs/FreshnessPolicy"
        },
        "freshness_state": {
          "enum": [
            "exact",
            "compatible_drift",
            "stale_readable",
            "blocked",
            "unknown",
            "rollback_required"
          ],
          "title": "Freshness State",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "organ_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Organ Id",
          "type": "string"
        },
        "owners": {
          "$ref": "#/$defs/OrganOwners"
        },
        "package_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "primitive_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Primitive Id",
          "type": "string"
        },
        "provider_watermark": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Watermark"
        },
        "receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualifiedEvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "self_report_is_security_authority": {
          "const": false,
          "default": false,
          "title": "Self Report Is Security Authority",
          "type": "boolean"
        },
        "server_schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Server Schema Digest",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "ttl_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl Seconds"
        },
        "warnings": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "organ_id",
        "capability_id",
        "primitive_id",
        "owners",
        "authority_ceiling",
        "source_revision",
        "deployed_revision",
        "package_identity",
        "server_schema_digest",
        "consumer_observed_digest",
        "provider_watermark",
        "observed_at",
        "freshness_state",
        "freshness_policy",
        "cache_scope",
        "evidence_refs",
        "effect_class",
        "applied_state",
        "trace_id"
      ],
      "title": "OrganResultMetadata",
      "type": "object"
    },
    "QualifiedEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Evidence Ref",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "evidence_ref",
        "revision",
        "observed_at"
      ],
      "title": "QualifiedEvidenceRef",
      "type": "object"
    },
    "RevisionIdentity": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "schema_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Digest"
        }
      },
      "required": [
        "revision"
      ],
      "title": "RevisionIdentity",
      "type": "object"
    }
  },
  "$id": "urn:aoa-sdk:organ-access:organ-result-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Minimal common metadata plus an owner-specific typed payload.",
  "properties": {
    "metadata": {
      "$ref": "#/$defs/OrganResultMetadata"
    },
    "owner_payload": {
      "title": "Owner Payload"
    },
    "owner_payload_schema_ref": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Owner Payload Schema Ref",
      "type": "string"
    }
  },
  "required": [
    "metadata",
    "owner_payload_schema_ref",
    "owner_payload"
  ],
  "title": "OrganResultEnvelope",
  "type": "object"
}
