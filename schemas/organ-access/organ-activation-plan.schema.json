{
  "$defs": {
    "EndpointContract": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_protocol_version": {
          "const": "aoa_organ_adapter_v1",
          "default": "aoa_organ_adapter_v1",
          "title": "Adapter Protocol Version",
          "type": "string"
        },
        "connection_mode": {
          "const": "direct_owner",
          "default": "direct_owner",
          "title": "Connection Mode",
          "type": "string"
        },
        "endpoint_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Endpoint Ref",
          "type": "string"
        },
        "protocol_versions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Protocol Versions",
          "type": "array"
        },
        "server_schema_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Schema Digest"
        },
        "transport": {
          "enum": [
            "stdio",
            "streamable-http",
            "owner-api",
            "none"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "transport",
        "endpoint_ref",
        "protocol_versions"
      ],
      "title": "EndpointContract",
      "type": "object"
    },
    "OrganOwners": {
      "additionalProperties": false,
      "properties": {
        "acceptance_owner": {
          "minLength": 1,
          "title": "Acceptance Owner",
          "type": "string"
        },
        "access_owner": {
          "minLength": 1,
          "title": "Access Owner",
          "type": "string"
        },
        "control_owner": {
          "const": "aoa-sdk",
          "default": "aoa-sdk",
          "title": "Control Owner",
          "type": "string"
        },
        "proof_owner": {
          "minLength": 1,
          "title": "Proof Owner",
          "type": "string"
        },
        "runtime_owner": {
          "minLength": 1,
          "title": "Runtime Owner",
          "type": "string"
        },
        "source_owner": {
          "minLength": 1,
          "title": "Source Owner",
          "type": "string"
        }
      },
      "required": [
        "source_owner",
        "access_owner",
        "runtime_owner",
        "proof_owner",
        "acceptance_owner"
      ],
      "title": "OrganOwners",
      "type": "object"
    },
    "QualifiedEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Evidence Ref",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "evidence_ref",
        "revision",
        "observed_at"
      ],
      "title": "QualifiedEvidenceRef",
      "type": "object"
    },
    "RevisionIdentity": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "schema_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Digest"
        }
      },
      "required": [
        "revision"
      ],
      "title": "RevisionIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualifiedEvidenceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "capability_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Capability Id",
      "type": "string"
    },
    "consumer_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Consumer Id",
      "type": "string"
    },
    "consumer_schema_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Consumer Schema Digest",
      "type": "string"
    },
    "credential_class": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Credential Class",
      "type": "string"
    },
    "deploy_revision": {
      "$ref": "#/$defs/RevisionIdentity"
    },
    "effect_class": {
      "enum": [
        "observe",
        "derive",
        "validate",
        "prepare_candidate",
        "apply_runtime",
        "accept_source",
        "external_emit",
        "external_change"
      ],
      "title": "Effect Class",
      "type": "string"
    },
    "endpoint": {
      "$ref": "#/$defs/EndpointContract"
    },
    "exact_effect_target": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exact Effect Target"
    },
    "execution_authorized": {
      "const": false,
      "default": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "organ_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Organ Id",
      "type": "string"
    },
    "owners": {
      "$ref": "#/$defs/OrganOwners"
    },
    "package_revision": {
      "$ref": "#/$defs/RevisionIdentity"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_kind": {
      "const": "candidate_only",
      "default": "candidate_only",
      "title": "Plan Kind",
      "type": "string"
    },
    "policy_family": {
      "enum": [
        "read",
        "candidate",
        "internal_effect",
        "external_effect"
      ],
      "title": "Policy Family",
      "type": "string"
    },
    "precondition_evidence": {
      "items": {
        "$ref": "#/$defs/QualifiedEvidenceRef"
      },
      "title": "Precondition Evidence",
      "type": "array"
    },
    "primitive_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Primitive Id",
      "type": "string"
    },
    "registry_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Registry Digest",
      "type": "string"
    },
    "rollback_route": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Rollback Route",
      "type": "string"
    },
    "schema_version": {
      "const": "aoa_organ_activation_plan_v1",
      "default": "aoa_organ_activation_plan_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "server_schema_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Server Schema Digest",
      "type": "string"
    },
    "source_revision": {
      "$ref": "#/$defs/RevisionIdentity"
    }
  },
  "required": [
    "plan_id",
    "registry_digest",
    "organ_id",
    "capability_id",
    "primitive_id",
    "owners",
    "policy_family",
    "effect_class",
    "credential_class",
    "endpoint",
    "source_revision",
    "package_revision",
    "deploy_revision",
    "server_schema_digest",
    "consumer_schema_digest",
    "consumer_id",
    "precondition_evidence",
    "expires_at",
    "rollback_route"
  ],
  "title": "OrganActivationPlan",
  "type": "object"
}
