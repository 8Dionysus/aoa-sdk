{
  "$defs": {
    "AdmissionTarget": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "credential_class": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Credential Class",
          "type": "string"
        },
        "organ_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Organ Id",
          "type": "string"
        },
        "policy_family": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Policy Family",
          "type": "string"
        },
        "primitive_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Primitive Ids",
          "type": "array"
        }
      },
      "required": [
        "organ_id",
        "capability_id",
        "primitive_ids",
        "policy_family",
        "credential_class"
      ],
      "title": "AdmissionTarget",
      "type": "object"
    }
  },
  "$id": "urn:aoa-sdk:organ-access:organ-admission-authorization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Id",
      "type": "string"
    },
    "authorized_at": {
      "format": "date-time",
      "title": "Authorized At",
      "type": "string"
    },
    "base_entry_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Base Entry Digest",
      "type": "string"
    },
    "base_registry_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Base Registry Digest",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "central_proof_computed_by_sdk": {
      "const": false,
      "default": false,
      "title": "Central Proof Computed By Sdk",
      "type": "boolean"
    },
    "compare_and_swap_required": {
      "const": true,
      "default": true,
      "title": "Compare And Swap Required",
      "type": "boolean"
    },
    "effect_activation_authorized": {
      "const": false,
      "default": false,
      "title": "Effect Activation Authorized",
      "type": "boolean"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "operator_decision_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operator Decision Id",
      "type": "string"
    },
    "owner_acceptance_inferred_by_sdk": {
      "const": false,
      "default": false,
      "title": "Owner Acceptance Inferred By Sdk",
      "type": "boolean"
    },
    "owner_decision_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Owner Decision Id",
      "type": "string"
    },
    "post_update_projection_verification_required": {
      "const": true,
      "default": true,
      "title": "Post Update Projection Verification Required",
      "type": "boolean"
    },
    "registry_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Registry Mutation Performed",
      "type": "boolean"
    },
    "registry_update_authorized": {
      "const": true,
      "default": true,
      "title": "Registry Update Authorized",
      "type": "boolean"
    },
    "schema_version": {
      "const": "aoa_organ_admission_authorization_v1",
      "default": "aoa_organ_admission_authorization_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/AdmissionTarget"
    },
    "target_record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Target Record Digest",
      "type": "string"
    }
  },
  "required": [
    "authorization_id",
    "candidate_id",
    "owner_decision_id",
    "operator_decision_id",
    "target",
    "target_record_digest",
    "base_registry_digest",
    "base_entry_digest",
    "authorized_at",
    "expires_at"
  ],
  "title": "OrganAdmissionAuthorization",
  "type": "object"
}
