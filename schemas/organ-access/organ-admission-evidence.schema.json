{
  "$defs": {
    "AdmissionTarget": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "credential_class": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Credential Class",
          "type": "string"
        },
        "organ_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Organ Id",
          "type": "string"
        },
        "policy_family": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Policy Family",
          "type": "string"
        },
        "primitive_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Primitive Ids",
          "type": "array"
        }
      },
      "required": [
        "organ_id",
        "capability_id",
        "primitive_ids",
        "policy_family",
        "credential_class"
      ],
      "title": "AdmissionTarget",
      "type": "object"
    },
    "OwnerValidatorBinding": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "validator_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Validator Ref",
          "type": "string"
        },
        "validator_revision": {
          "minLength": 1,
          "title": "Validator Revision",
          "type": "string"
        },
        "validator_schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Validator Schema Digest",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "validator_ref",
        "validator_revision",
        "validator_schema_digest"
      ],
      "title": "OwnerValidatorBinding",
      "type": "object"
    }
  },
  "$id": "urn:aoa-sdk:organ-access:organ-admission-evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contains_secrets": {
      "const": false,
      "default": false,
      "title": "Contains Secrets",
      "type": "boolean"
    },
    "evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Digest",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_ref": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Evidence Ref",
      "type": "string"
    },
    "evidence_revision": {
      "minLength": 1,
      "title": "Evidence Revision",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issuer": {
      "minLength": 1,
      "title": "Issuer",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "passed",
        "blocked",
        "rejected"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "owner_native_validation_claimed": {
      "const": true,
      "default": true,
      "title": "Owner Native Validation Claimed",
      "type": "boolean"
    },
    "previous_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Previous Snapshot Digest",
      "type": "string"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "run_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "aoa_organ_admission_evidence_v1",
      "default": "aoa_organ_admission_evidence_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "enum": [
        "owner_source",
        "reviewed_revision",
        "package",
        "deploy_manifest",
        "deployed_bytes",
        "process_identity",
        "endpoint",
        "observed_schema",
        "auth_contour",
        "consumer_registration",
        "authenticated_canary",
        "owner_grounding_freshness",
        "central_proof",
        "owner_result_acceptance",
        "rollback_proof"
      ],
      "title": "Stage",
      "type": "string"
    },
    "subject_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Subject Digest",
      "type": "string"
    },
    "subject_ref": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Subject Ref",
      "type": "string"
    },
    "subject_revision": {
      "minLength": 1,
      "title": "Subject Revision",
      "type": "string"
    },
    "subject_schema_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Subject Schema Digest",
      "type": "string"
    },
    "subject_schema_ref": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Subject Schema Ref",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/AdmissionTarget"
    },
    "validation_receipt_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Validation Receipt Digest",
      "type": "string"
    },
    "validation_receipt_ref": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Validation Receipt Ref",
      "type": "string"
    },
    "validator": {
      "$ref": "#/$defs/OwnerValidatorBinding"
    }
  },
  "required": [
    "run_id",
    "previous_snapshot_digest",
    "stage",
    "issuer",
    "owner",
    "target",
    "subject_ref",
    "subject_revision",
    "subject_digest",
    "subject_schema_ref",
    "subject_schema_digest",
    "evidence_ref",
    "evidence_revision",
    "evidence_digest",
    "validator",
    "validation_receipt_ref",
    "validation_receipt_digest",
    "observed_at",
    "expires_at",
    "outcome",
    "evidence_id"
  ],
  "title": "AdmissionEvidenceReceipt",
  "type": "object"
}
