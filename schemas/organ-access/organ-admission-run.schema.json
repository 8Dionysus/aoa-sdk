{
  "$defs": {
    "AdmissionEvidenceReceipt": {
      "additionalProperties": false,
      "properties": {
        "contains_secrets": {
          "const": false,
          "default": false,
          "title": "Contains Secrets",
          "type": "boolean"
        },
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Evidence Ref",
          "type": "string"
        },
        "evidence_revision": {
          "minLength": 1,
          "title": "Evidence Revision",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issuer": {
          "minLength": 1,
          "title": "Issuer",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "passed",
            "blocked",
            "rejected"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "owner_native_validation_claimed": {
          "const": true,
          "default": true,
          "title": "Owner Native Validation Claimed",
          "type": "boolean"
        },
        "previous_snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Previous Snapshot Digest",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "run_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "aoa_organ_admission_evidence_v1",
          "default": "aoa_organ_admission_evidence_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "enum": [
            "owner_source",
            "reviewed_revision",
            "package",
            "deploy_manifest",
            "deployed_bytes",
            "process_identity",
            "endpoint",
            "observed_schema",
            "auth_contour",
            "consumer_registration",
            "authenticated_canary",
            "owner_grounding_freshness",
            "central_proof",
            "owner_result_acceptance",
            "rollback_proof"
          ],
          "title": "Stage",
          "type": "string"
        },
        "subject_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Subject Digest",
          "type": "string"
        },
        "subject_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Subject Ref",
          "type": "string"
        },
        "subject_revision": {
          "minLength": 1,
          "title": "Subject Revision",
          "type": "string"
        },
        "subject_schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Subject Schema Digest",
          "type": "string"
        },
        "subject_schema_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Subject Schema Ref",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/AdmissionTarget"
        },
        "validation_receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Validation Receipt Digest",
          "type": "string"
        },
        "validation_receipt_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Validation Receipt Ref",
          "type": "string"
        },
        "validator": {
          "$ref": "#/$defs/OwnerValidatorBinding"
        }
      },
      "required": [
        "run_id",
        "previous_snapshot_digest",
        "stage",
        "issuer",
        "owner",
        "target",
        "subject_ref",
        "subject_revision",
        "subject_digest",
        "subject_schema_ref",
        "subject_schema_digest",
        "evidence_ref",
        "evidence_revision",
        "evidence_digest",
        "validator",
        "validation_receipt_ref",
        "validation_receipt_digest",
        "observed_at",
        "expires_at",
        "outcome",
        "evidence_id"
      ],
      "title": "AdmissionEvidenceReceipt",
      "type": "object"
    },
    "AdmissionTarget": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "credential_class": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Credential Class",
          "type": "string"
        },
        "organ_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Organ Id",
          "type": "string"
        },
        "policy_family": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Policy Family",
          "type": "string"
        },
        "primitive_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Primitive Ids",
          "type": "array"
        }
      },
      "required": [
        "organ_id",
        "capability_id",
        "primitive_ids",
        "policy_family",
        "credential_class"
      ],
      "title": "AdmissionTarget",
      "type": "object"
    },
    "CapabilityContract": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "credential_class": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Credential Class",
          "type": "string"
        },
        "eval_refs": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 3,
            "type": "string"
          },
          "title": "Eval Refs",
          "type": "array"
        },
        "owner_payload_schema_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Owner Payload Schema Ref",
          "type": "string"
        },
        "policy_family": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Policy Family",
          "type": "string"
        },
        "primitives": {
          "items": {
            "$ref": "#/$defs/PrimitiveContract"
          },
          "title": "Primitives",
          "type": "array"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 12,
          "title": "Summary",
          "type": "string"
        },
        "task_intent_terms": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
            "type": "string"
          },
          "title": "Task Intent Terms",
          "type": "array"
        }
      },
      "required": [
        "capability_id",
        "summary",
        "policy_family",
        "credential_class",
        "primitives",
        "owner_payload_schema_ref"
      ],
      "title": "CapabilityContract",
      "type": "object"
    },
    "OrganAdmissionRequest": {
      "additionalProperties": false,
      "properties": {
        "automatic_effect_activation_allowed": {
          "const": false,
          "default": false,
          "title": "Automatic Effect Activation Allowed",
          "type": "boolean"
        },
        "automatic_registry_update_allowed": {
          "const": false,
          "default": false,
          "title": "Automatic Registry Update Allowed",
          "type": "boolean"
        },
        "central_proof_may_be_issued_by_sdk": {
          "const": false,
          "default": false,
          "title": "Central Proof May Be Issued By Sdk",
          "type": "boolean"
        },
        "consumer_owner": {
          "minLength": 1,
          "title": "Consumer Owner",
          "type": "string"
        },
        "contains_secrets": {
          "const": false,
          "default": false,
          "title": "Contains Secrets",
          "type": "boolean"
        },
        "current_registry": {
          "$ref": "#/$defs/RegistryComparisonAnchor"
        },
        "default_admission": {
          "const": "deny",
          "default": "deny",
          "title": "Default Admission",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "operator_owner": {
          "minLength": 1,
          "title": "Operator Owner",
          "type": "string"
        },
        "owner_acceptance_may_be_issued_by_sdk": {
          "const": false,
          "default": false,
          "title": "Owner Acceptance May Be Issued By Sdk",
          "type": "boolean"
        },
        "owner_validator_bindings": {
          "items": {
            "$ref": "#/$defs/OwnerValidatorBinding"
          },
          "minItems": 1,
          "title": "Owner Validator Bindings",
          "type": "array"
        },
        "owners": {
          "$ref": "#/$defs/OrganOwners"
        },
        "proposed_capability": {
          "$ref": "#/$defs/CapabilityContract"
        },
        "request_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "requested_by": {
          "minLength": 1,
          "title": "Requested By",
          "type": "string"
        },
        "schema_version": {
          "const": "aoa_organ_admission_request_v1",
          "default": "aoa_organ_admission_request_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/AdmissionTarget"
        }
      },
      "required": [
        "request_id",
        "requested_by",
        "operator_owner",
        "consumer_owner",
        "owners",
        "target",
        "proposed_capability",
        "current_registry",
        "owner_validator_bindings",
        "requested_at",
        "expires_at"
      ],
      "title": "OrganAdmissionRequest",
      "type": "object"
    },
    "OrganOwners": {
      "additionalProperties": false,
      "properties": {
        "acceptance_owner": {
          "minLength": 1,
          "title": "Acceptance Owner",
          "type": "string"
        },
        "access_owner": {
          "minLength": 1,
          "title": "Access Owner",
          "type": "string"
        },
        "control_owner": {
          "const": "aoa-sdk",
          "default": "aoa-sdk",
          "title": "Control Owner",
          "type": "string"
        },
        "proof_owner": {
          "minLength": 1,
          "title": "Proof Owner",
          "type": "string"
        },
        "runtime_owner": {
          "minLength": 1,
          "title": "Runtime Owner",
          "type": "string"
        },
        "source_owner": {
          "minLength": 1,
          "title": "Source Owner",
          "type": "string"
        }
      },
      "required": [
        "source_owner",
        "access_owner",
        "runtime_owner",
        "proof_owner",
        "acceptance_owner"
      ],
      "title": "OrganOwners",
      "type": "object"
    },
    "OwnerValidatorBinding": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "validator_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Validator Ref",
          "type": "string"
        },
        "validator_revision": {
          "minLength": 1,
          "title": "Validator Revision",
          "type": "string"
        },
        "validator_schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Validator Schema Digest",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "validator_ref",
        "validator_revision",
        "validator_schema_digest"
      ],
      "title": "OwnerValidatorBinding",
      "type": "object"
    },
    "PrimitiveContract": {
      "additionalProperties": false,
      "properties": {
        "annotations_are_security_enforcement": {
          "const": false,
          "default": false,
          "title": "Annotations Are Security Enforcement",
          "type": "boolean"
        },
        "approval_owner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Owner"
        },
        "approval_required": {
          "default": false,
          "title": "Approval Required",
          "type": "boolean"
        },
        "effect_class": {
          "enum": [
            "observe",
            "derive",
            "validate",
            "prepare_candidate",
            "apply_runtime",
            "accept_source",
            "external_emit",
            "external_change"
          ],
          "title": "Effect Class",
          "type": "string"
        },
        "idempotency": {
          "enum": [
            "read_only",
            "idempotent",
            "idempotency_key_required",
            "non_idempotent"
          ],
          "title": "Idempotency",
          "type": "string"
        },
        "input_schema_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Schema Ref"
        },
        "kind": {
          "enum": [
            "tool",
            "resource",
            "resource_template",
            "prompt"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum_blast_radius": {
          "minLength": 1,
          "title": "Maximum Blast Radius",
          "type": "string"
        },
        "mcp_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcp Name"
        },
        "output_schema_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Output Schema Ref",
          "type": "string"
        },
        "policy_family": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Policy Family",
          "type": "string"
        },
        "primitive_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Primitive Id",
          "type": "string"
        },
        "rollback_route": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rollback Route"
        }
      },
      "required": [
        "primitive_id",
        "kind",
        "effect_class",
        "policy_family",
        "output_schema_ref",
        "idempotency",
        "maximum_blast_radius"
      ],
      "title": "PrimitiveContract",
      "type": "object"
    },
    "RegistryComparisonAnchor": {
      "additionalProperties": false,
      "properties": {
        "entry_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Entry Digest",
          "type": "string"
        },
        "entry_state": {
          "enum": [
            "declared",
            "package_candidate",
            "deploy_candidate",
            "shadow",
            "admitted",
            "suspended",
            "deprecated",
            "retired"
          ],
          "title": "Entry State",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "registry_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Registry Digest",
          "type": "string"
        },
        "registry_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Registry Id",
          "type": "string"
        }
      },
      "required": [
        "registry_id",
        "registry_digest",
        "entry_digest",
        "entry_state",
        "observed_at",
        "expires_at"
      ],
      "title": "RegistryComparisonAnchor",
      "type": "object"
    }
  },
  "$id": "urn:aoa-sdk:organ-access:organ-admission-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "central_proof_computed_by_sdk": {
      "const": false,
      "default": false,
      "title": "Central Proof Computed By Sdk",
      "type": "boolean"
    },
    "effect_activation_authorized": {
      "const": false,
      "default": false,
      "title": "Effect Activation Authorized",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/AdmissionEvidenceReceipt"
      },
      "title": "Evidence",
      "type": "array"
    },
    "next_owner": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Owner"
    },
    "next_stage": {
      "anyOf": [
        {
          "enum": [
            "owner_source",
            "reviewed_revision",
            "package",
            "deploy_manifest",
            "deployed_bytes",
            "process_identity",
            "endpoint",
            "observed_schema",
            "auth_contour",
            "consumer_registration",
            "authenticated_canary",
            "owner_grounding_freshness",
            "central_proof",
            "owner_result_acceptance",
            "rollback_proof"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Stage"
    },
    "owner_acceptance_inferred_by_sdk": {
      "const": false,
      "default": false,
      "title": "Owner Acceptance Inferred By Sdk",
      "type": "boolean"
    },
    "owner_validators_executed_by_sdk": {
      "const": false,
      "default": false,
      "title": "Owner Validators Executed By Sdk",
      "type": "boolean"
    },
    "registry_mutated_by_sdk": {
      "const": false,
      "default": false,
      "title": "Registry Mutated By Sdk",
      "type": "boolean"
    },
    "request": {
      "$ref": "#/$defs/OrganAdmissionRequest"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "run_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "aoa_organ_admission_run_v1",
      "default": "aoa_organ_admission_run_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Snapshot Digest",
      "type": "string"
    },
    "state": {
      "enum": [
        "collecting",
        "ready_for_candidate",
        "blocked",
        "rejected"
      ],
      "title": "State",
      "type": "string"
    },
    "stop_reason_codes": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
        "type": "string"
      },
      "title": "Stop Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "request_digest",
    "request",
    "evidence",
    "snapshot_digest",
    "state",
    "next_stage",
    "next_owner"
  ],
  "title": "OrganAdmissionRun",
  "type": "object"
}
