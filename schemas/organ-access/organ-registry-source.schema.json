    "EndpointContract": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_protocol_version": {
          "const": "aoa_organ_adapter_v1",
          "default": "aoa_organ_adapter_v1",
          "title": "Adapter Protocol Version",
          "type": "string"
        },
        "connection_mode": {
          "const": "direct_owner",
          "default": "direct_owner",
          "title": "Connection Mode",
          "type": "string"
