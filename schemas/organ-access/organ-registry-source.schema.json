    "CapabilityContract": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "credential_class": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Credential Class",
          "type": "string"
        },
        "eval_refs": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 3,
            "type": "string"
          },
          "title": "Eval Refs",
          "type": "array"
        },
        "owner_payload_schema_ref": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Owner Payload Schema Ref",
          "type": "string"
        },
        "policy_family": {
          "enum": [
            "read",
            "candidate",
            "internal_effect",
            "external_effect"
          ],
          "title": "Policy Family",
          "type": "string"
        },
        "primitives": {
          "items": {
            "$ref": "#/$defs/PrimitiveContract"
          },
          "title": "Primitives",
          "type": "array"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 12,
          "title": "Summary",
          "type": "string"
        },
        "task_intent_terms": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
            "type": "string"
          },
          "title": "Task Intent Terms",
          "type": "array"
        }
      },
      "required": [
        "capability_id",
        "summary",
        "policy_family",
        "credential_class",
        "primitives",
        "owner_payload_schema_ref"
      ],
      "title": "CapabilityContract",
      "type": "object"
    },
    "ConsumerCompatibility": {
      "additionalProperties": false,
      "properties": {
        "consumer_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
