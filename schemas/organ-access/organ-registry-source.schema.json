        "protocol_versions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Protocol Versions",
          "type": "array"
        },
        "server_schema_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
