        "observed_schema_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Schema Digest"
        },
        "protocol_versions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Protocol Versions",
          "type": "array"
